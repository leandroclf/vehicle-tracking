# Arquivo de exemplo de variáveis de ambiente para o sistema de rastreamento veicular Yukz
# Copie este arquivo para .env e preencha com seus valores reais

# Supabase - Banco de dados e autenticação
NEXT_PUBLIC_SUPABASE_URL=sua_url_supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anonima_supabase
SUPABASE_SERVICE_KEY=sua_chave_servico_supabase

# Google Maps API - Para funcionalidades de mapa
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=sua_chave_api_google_maps

# JWT - Para autenticação
JWT_SECRET=sua_chave_secreta_jwt

# Ambiente
NODE_ENV=development