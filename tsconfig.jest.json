{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node",
        "jsx": "react",
        "noEmit": false,
        "esModuleInterop": true,
        "types": [
            "node",
            "jest"
        ]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "jest.config.js"
    ],
    "exclude": [
        "node_modules",
        "supabase",
        "tracker-server"
    ]
}